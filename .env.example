# Copy this file to `.env` or `.env.local` and adjust as needed.
# Both are git-ignored. Never commit real keys, usernames, server addresses,
# private cache paths, or private artifact locations.

# ---- IBM Granite models from Hugging Face ----
# Optional for public models; useful for gated models or download rate limits.
HUGGINGFACE_API_KEY=

# Granite embedding model used by the Retriever module.
GRANITE_EMBEDDING_MODEL_ID=ibm-granite/granite-embedding-english-r2

# Granite language model used by the Generator module.
GRANITE_MODEL_ID=ibm-granite/granite-4.1-3b

# ---- Local runtime ----
# Empty means the default Hugging Face cache. On HPC, set this to shared storage.
MODEL_CACHE_DIR=

# Generation device: auto, cuda, or cpu.
LLM_DEVICE=auto

# ---- Frozen three-module runtime ----
# These paths are consumed by configs/runtime/final_seed13.toml. Keep them empty
# until real local/HPC paths are available; startup reports every missing value.
EVIDENCE_RAG_DATASET_MANIFEST=
EVIDENCE_RAG_OUTPUT_DIR=
EVIDENCE_RAG_MODEL_CACHE=
EVIDENCE_RAG_SELECTOR_CHECKPOINT=
EVIDENCE_RAG_GENERATOR_ADAPTER=

# UI demo only: retain the NLI Protect-Harm interface while explicitly using
# TopK10 when the restricted Selector checkpoint is unavailable. Set to 0 for
# fail-closed behavior; this never fabricates NLI scores.
EVIDENCE_RAG_DEMO_NLI_FALLBACK=1

# Optional: an existing compatible retriever index and a non-default config.
EVIDENCE_RAG_INDEX_DIR=
EVIDENCE_RAG_RUNTIME_CONFIG=configs/runtime/final_seed13.toml
HF_HOME="${EVIDENCE_RAG_MODEL_CACHE}"
