{
  "schema_version": "1.0",
  "fields": {
    "query_id": {"type": "string", "required": true},
    "candidate_id": {"type": "string", "required": true},
    "source_parent_id": {"type": "string", "required": true},
    "answer_cluster_id": {"type": "string", "required": false, "nullable": true},
    "required_fact_set_id": {"type": "string", "required": false, "nullable": true},
    "support_level": {"allowed_values": ["direct", "partial", "none"]},
    "factual_status": {"allowed_values": ["correct", "incorrect", "disputed", "unknown"]},
    "entity_match": {"allowed_values": ["match", "mismatch", "unknown", "not_applicable"]},
    "time_match": {"allowed_values": ["match", "mismatch", "unknown", "not_applicable", "outdated"]},
    "condition_match": {"allowed_values": ["match", "mismatch", "unknown", "not_applicable"]},
    "answerability": {"allowed_values": ["answer", "non_answer", "extraction_failure"]},
    "source_quality": {"allowed_values": ["strong", "weak", "unknown"]},
    "conflict_to_gold": {"allowed_values": ["yes", "no", "unknown"]},
    "label_provenance": {"allowed_values": ["official", "human", "deterministic_rule", "independent_teacher"]},
    "utility_grade": {"type": "integer", "minimum": 0, "maximum": 4},
    "label_confidence": {"type": "float", "minimum": 0.0, "maximum": 1.0},
    "harm_type": {"type": "string", "required": false, "nullable": true}
  },
  "derived_flags": {
    "is_harmful": "utility_grade == 0",
    "is_direct_support": "utility_grade == 4",
    "is_required_support": "utility_grade >= 3"
  }
}
