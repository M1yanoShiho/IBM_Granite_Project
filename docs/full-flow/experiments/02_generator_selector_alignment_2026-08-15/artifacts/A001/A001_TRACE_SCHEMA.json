{
  "$defs": {
    "ClaimTrace": {
      "additionalProperties": false,
      "properties": {
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "claim_text": {
          "minLength": 1,
          "title": "Claim Text",
          "type": "string"
        },
        "conflict_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Evidence Id"
        },
        "declared_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Declared Indices",
          "type": "array"
        },
        "degraded_splitter_fallback": {
          "title": "Degraded Splitter Fallback",
          "type": "boolean"
        },
        "faithful_to_answer": {
          "title": "Faithful To Answer",
          "type": "boolean"
        },
        "final_disposition": {
          "enum": [
            "verified",
            "unverified",
            "dropped_entity_conflict",
            "skipped_unfaithful",
            "skipped_empty_sentence"
          ],
          "title": "Final Disposition",
          "type": "string"
        },
        "final_sentence": {
          "default": "",
          "title": "Final Sentence",
          "type": "string"
        },
        "gated_citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gated Citation"
        },
        "gated_outcome": {
          "default": "",
          "title": "Gated Outcome",
          "type": "string"
        },
        "routing_outcome": {
          "default": "",
          "title": "Routing Outcome",
          "type": "string"
        },
        "schema_version": {
          "const": "full-flow-claim-trace-v1",
          "default": "full-flow-claim-trace-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "span_end": {
          "title": "Span End",
          "type": "integer"
        },
        "span_start": {
          "title": "Span Start",
          "type": "integer"
        }
      },
      "required": [
        "claim_id",
        "claim_text",
        "span_start",
        "span_end",
        "faithful_to_answer",
        "degraded_splitter_fallback",
        "final_disposition"
      ],
      "title": "ClaimTrace",
      "type": "object"
    },
    "DraftStageTrace": {
      "additionalProperties": false,
      "properties": {
        "draft_empty_reason": {
          "default": "",
          "enum": [
            "",
            "no_selected_evidence",
            "model_decline_or_empty",
            "unknown"
          ],
          "title": "Draft Empty Reason",
          "type": "string"
        },
        "key_fact_note_count": {
          "default": 0,
          "title": "Key Fact Note Count",
          "type": "integer"
        },
        "mode": {
          "enum": [
            "ordinary",
            "key_fact_notes",
            "key_fact_fallback",
            "external"
          ],
          "title": "Mode",
          "type": "string"
        },
        "normalized_draft_text": {
          "title": "Normalized Draft Text",
          "type": "string"
        },
        "raw_draft_text": {
          "title": "Raw Draft Text",
          "type": "string"
        },
        "raw_output_available": {
          "title": "Raw Output Available",
          "type": "boolean"
        },
        "schema_version": {
          "const": "full-flow-draft-stage-trace-v1",
          "default": "full-flow-draft-stage-trace-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "splitter": {
          "$ref": "#/$defs/SplitterTrace"
        }
      },
      "required": [
        "mode",
        "raw_draft_text",
        "normalized_draft_text",
        "raw_output_available",
        "splitter"
      ],
      "title": "DraftStageTrace",
      "type": "object"
    },
    "SplitterTrace": {
      "additionalProperties": false,
      "properties": {
        "failure_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Message"
        },
        "failure_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Type"
        },
        "faithfulness_raw_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Faithfulness Raw Output"
        },
        "located_claim_count": {
          "default": 0,
          "title": "Located Claim Count",
          "type": "integer"
        },
        "output_claim_count": {
          "default": 0,
          "title": "Output Claim Count",
          "type": "integer"
        },
        "raw_claim_count": {
          "default": 0,
          "title": "Raw Claim Count",
          "type": "integer"
        },
        "retained_claim_count": {
          "default": 0,
          "title": "Retained Claim Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "full-flow-splitter-trace-v1",
          "default": "full-flow-splitter-trace-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "split_raw_output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Split Raw Output"
        },
        "status": {
          "enum": [
            "not_run_empty_draft",
            "structured",
            "degraded_fallback",
            "failed",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "SplitterTrace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One query's complete runtime Generator trace.\n\nThe schema is deliberately limited to fields available after Selector output.\nEvaluation code may join this trace to gold only after generation completes.",
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimTrace"
      },
      "title": "Claims",
      "type": "array"
    },
    "draft": {
      "$ref": "#/$defs/DraftStageTrace"
    },
    "final_answer": {
      "title": "Final Answer",
      "type": "string"
    },
    "final_cited_evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Final Cited Evidence Ids",
      "type": "array"
    },
    "final_empty_reason": {
      "default": "",
      "enum": [
        "",
        "empty_draft",
        "splitter_no_claims",
        "all_claims_unfaithful",
        "all_claims_removed_or_empty",
        "capped_no_verified"
      ],
      "title": "Final Empty Reason",
      "type": "string"
    },
    "query_id": {
      "minLength": 1,
      "title": "Query Id",
      "type": "string"
    },
    "schema_version": {
      "const": "full-flow-generator-trace-v1",
      "default": "full-flow-generator-trace-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Selected Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "query_id",
    "selected_evidence_ids",
    "draft",
    "claims",
    "final_answer",
    "final_cited_evidence_ids"
  ],
  "title": "GeneratorTrace",
  "type": "object"
}
